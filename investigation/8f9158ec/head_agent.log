#!/usr/bin/env python3
"""Generate all decks and auto-import into Anki via AnkiConnect.

Usage:
    python deploy.py          # generate + import all 7 decks
    python deploy.py --gen    # only generate (no import)

Requires: AnkiConnect addon (2055492159) installed + Anki running.
"""
import subprocess
import sys
import os
import time
import json
import urllib.request

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
ANKICONNECT_URL = "http://localhost:8765"


def anki_request(action, **params):
    """Send a request to AnkiConnect."""
    payload = json.dumps({"action": action, "version": 6, "params": params}).encode()
    req = urllib.request.Request(ANKICONNECT_URL, data=payload)
    try:
        resp = urllib.request.urlopen(req, timeout=30)
        result = json.loads(resp.read())
        if result.get("error"):
            raise RuntimeError(f"AnkiConnect error: {result['error']}")
        return result.get("result")
    except urllib.error.URLError:
        return None


def wait_for_anki(timeout=10):
    """Wait for AnkiConnect to respond."""
    for _ in range(timeout):
        v = anki_request("version")
        if v is not None:
            return True
        time.sleep(1)
    return False


def import_package(path):
    """Import .apkg via AnkiConnect."""
    return anki_request("importPackage", path=path)


def main():
    gen_only = "--gen" in sys.argv

    # 1. Generate all decks
    print("⚙️  Generating decks...")
    result = subprocess.run(
        [sys.executable, os.path.join(SCRIPT_DIR, "gen_all_decks.py")],
        cwd=SCRIPT_DIR, capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"❌ Generation failed:\n{result.stderr}")
        sys.exit(1)
    print(result.stdout)

    if gen_only:
        return

    # 2. Connect to AnkiConnect
    print("🔌 Connecting to AnkiConnect...")
    if not wait_for_anki(5):
        print("❌ AnkiConnect not responding. Make sure:")
        print("   1. Anki is running")
        print("   2. AnkiConnect addon (2055492159) is installed")
        print("   3. Restart Anki after installing the addon")
        sys.exit(1)

    print(f"   ✅ AnkiConnect v{anki_request('version')}")

    # 3. Import each .apkg
    apkg_files = sorted(f for f in os.listdir(SCRIPT_DIR) if f.startswith("deck_") and f.endswith(".apkg"))
    if not apkg_files:
        print("❌ No deck_*.apkg files found")
        sys.exit(1)

    for apkg in apkg_files:
        path = os.path.join(SCRIPT_DIR, apkg)
        print(f"   📥 Importing {apkg}...", end=" ")
        import_package(path)
        print("✅")

    # 4. Sync (optional)
    anki_request("sync")
    print(f"\n🎉 Done! {len(apkg_files)} decks imported and synced.")


if __name__ == "__main__":
    main()
