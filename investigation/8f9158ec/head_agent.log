#!/usr/bin/env python3
"""Generate all 7 verb ending decks (50 cards each, 84 forms in back)."""
import unicodedata
import sys
import os
import genanki

sys.path.insert(0, os.path.dirname(__file__))
from paradigm_data import TENSES, ALL_84
from verb_bank import VERBS

# Load LLM-generated explanations cache
_CACHE_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "explanations_cache.json")
import json as _json
EXPLANATIONS = {}
if os.path.exists(_CACHE_PATH):
    with open(_CACHE_PATH) as _f:
        EXPLANATIONS = _json.load(_f)

B = "<br>"

def nfc(s):
    return unicodedata.normalize("NFC", s)


def _strip_accents(c):
    decomposed = unicodedata.normalize("NFD", c)
    return ''.join(ch for ch in decomposed if unicodedata.category(ch) != 'Mn')


def _has_accent(c):
    decomposed = unicodedata.normalize("NFD", c)
    return any('OXIA' in unicodedata.name(ch, '') or 'TONOS' in unicodedata.name(ch, '') or 'ACUTE' in unicodedata.name(ch, '') for ch in decomposed if unicodedata.category(ch) == 'Mn')


def byzantine_pronunciation(text):
    """Convert Greek text to Byzantine/Modern pronunciation."""
    text = unicodedata.normalize("NFC", text)
    voiceless = set("κπτφθχξψσς")
    result, stressed = [], []
    i, chars = 0, list(text)

    while i < len(chars):
        c = chars[i]
        base = _strip_accents(c).lower()
        is_stressed = _has_accent(c)
        nb = _strip_accents(chars[i+1]).lower() if i+1 < len(chars) else ''

        if not base.isalpha() or base in 'abcdefghijklmnopqrstuvwxyz':
            result.append(c); stressed.append(False); i += 1; continue

        # Digraphs
        ns = _has_accent(chars[i+1]) if i+1 < len(chars) else False
        if base == 'α' and nb == 'ι':
            result.append('e'); stressed.append(is_stressed or ns); i += 2
        elif base == 'ε' and nb == 'ι':
            result.append('i'); stressed.append(is_stressed or ns); i += 2
        elif base == 'ο' and nb == 'ι':
            result.append('i'); stressed.append(is_stressed or ns); i += 2
        elif base == 'ο' and nb == 'υ':
            result.append('u'); stressed.append(is_stressed or ns); i += 2
        elif base == 'υ' and nb == 'ι':
            result.append('i'); stressed.append(is_stressed or ns); i += 2
        elif base == 'α' and nb == 'υ':
            after = _strip_accents(chars[i+2]).lower() if i+2 < len(chars) else ''
            result.append('af' if after in voiceless or after in ('', ' ') else 'av')
            stressed.append(is_stressed or ns); i += 2
        elif base == 'ε' and nb == 'υ':
            after = _strip_accents(chars[i+2]).lower() if i+2 < len(chars) else ''
            result.append('ef' if after in voiceless or after in ('', ' ') else 'ev')
            stressed.append(is_stressed or ns); i += 2
        elif base == 'γ' and nb == 'γ':
            result.append('ng'); stressed.append(False); i += 2
        elif base == 'γ' and nb in ('κ', 'ξ', 'χ'):
            result.append('n'); stressed.append(False); i += 1
        elif base == 'γ' and nb in ('ε', 'ι', 'η', 'υ'):
            result.append('y'); stressed.append(False); i += 1
        # Singles
        elif base == 'α': result.append('a'); stressed.append(is_stressed); i += 1
        elif base in ('η', 'ι', 'υ'): result.append('i'); stressed.append(is_stressed); i += 1
        elif base == 'ε': result.append('e'); stressed.append(is_stressed); i += 1
        elif base in ('ο', 'ω'): result.append('o'); stressed.append(is_stressed); i += 1
        elif base == 'β': result.append('v'); stressed.append(False); i += 1
        elif base == 'γ': result.append('ɣ'); stressed.append(False); i += 1
        elif base == 'δ': result.append('ð'); stressed.append(False); i += 1
        elif base == 'ζ': result.append('z'); stressed.append(False); i += 1
        elif base == 'θ': result.append('θ'); stressed.append(False); i += 1
        elif base == 'κ': result.append('k'); stressed.append(False); i += 1
        elif base == 'λ': result.append('l'); stressed.append(False); i += 1
        elif base == 'μ': result.append('m'); stressed.append(False); i += 1
        elif base == 'ν': result.append('n'); stressed.append(False); i += 1
        elif base == 'ξ': result.append('ks'); stressed.append(False); i += 1
        elif base == 'π': result.append('p'); stressed.append(False); i += 1
        elif base == 'ρ': result.append('r'); stressed.append(False); i += 1
        elif base in ('σ', 'ς'): result.append('s'); stressed.append(False); i += 1
        elif base == 'τ': result.append('t'); stressed.append(False); i += 1
        elif base == 'φ': result.append('f'); stressed.append(False); i += 1
        elif base == 'χ': result.append('j'); stressed.append(False); i += 1
        elif base == 'ψ': result.append('ps'); stressed.append(False); i += 1
        else: result.append(c); stressed.append(False); i += 1

    accent_map = {'a': 'á', 'e': 'é', 'i': 'í', 'o': 'ó', 'u': 'ú'}
    output = []
    for r, s in zip(result, stressed):
        if s and r.isalpha():
            done = False
            acc = ''
            for ch in r:
                if ch in accent_map and not done:
                    acc += accent_map[ch]; done = True
                else:
                    acc += ch
            output.append(acc)
        else:
            output.append(r)
    return ''.join(output)

# Deck configs: (deck_idx, name, model_id, deck_id, tense_indices_for_question)
# tense_indices_for_question: which of the 7 tense blocks (0-6) this deck tests
# The 12 forms to guess = the endings from that tense block
DECK_CONFIGS = [
    (0, "Presente", 1847293651, 1847293652, 0),
    (1, "Imperfecto", 1847293653, 1847293654, 1),
    (2, "Futuro Act+Med", 1847293655, 1847293656, 2),
    (3, "Futuro Pas + Aoristo Pas", 1847293657, 1847293658, 3),
    (4, "Aoristo Act+Med", 1847293659, 1847293660, 4),
    (5, "Perfecto", 1847293661, 1847293662, 5),
    (6, "Pluscuamperfecto", 1847293663, 1847293664, 6),
]

# Which verbs to use for each card (cycle through available verbs)
VERB_KEYS = list(VERBS.keys())

def get_tense_offset(tense_idx):
    """Get the starting index in the 84-form list for a given tense."""
    offset = 0
    for i in range(tense_idx):
        offset += len(TENSES[i][2])
    return offset

def _get_hint(person_label):
    """Give a contextual hint without revealing the exact answer."""
    HINTS = {
        "1sg act": "Una sola persona habla de sí misma y hace la acción.",
        "2sg act": "Le hablas a una persona y ella hace la acción.",
        "3sg act": "Una tercera persona hace la acción.",
        "1pl act": "Un grupo que incluye al hablante hace la acción.",
        "2pl act": "Le hablas a un grupo (sin incluirte) y ellos hacen la acción.",
        "3pl act": "Un grupo de terceras personas hace la acción.",
        "1sg m/p": "Una sola persona habla de sí misma y recibe la acción (o verbo deponente).",
        "2sg m/p": "Le hablas a una persona y ella recibe la acción.",
        "3sg m/p": "Una tercera persona recibe la acción.",
        "1pl m/p": "Un grupo que incluye al hablante recibe la acción.",
        "2pl m/p": "Le hablas a un grupo (sin incluirte) y ellos reciben la acción.",
        "3pl m/p": "Un grupo de terceras personas recibe la acción.",
        "1sg med": "Una sola persona hace la acción para sí misma.",
        "2sg med": "Le hablas a una persona que hace la acción para sí misma.",
        "3sg med": "Una tercera persona hace la acción para sí misma.",
        "1pl med": "Un grupo que incluye al hablante hace la acción para sí mismos.",
        "2pl med": "Le hablas a un grupo que hace la acción para sí mismos.",
        "3pl med": "Un grupo de terceras personas hace la acción para sí mismos.",
        "1sg fut.pas": "Una sola persona habla de sí misma y recibirá la acción.",
        "2sg fut.pas": "Le hablas a una persona que recibirá la acción.",
        "3sg fut.pas": "Una tercera persona recibirá la acción.",
        "1pl fut.pas": "Un grupo que incluye al hablante recibirá la acción.",
        "2pl fut.pas": "Le hablas a un grupo que recibirá la acción.",
        "3pl fut.pas": "Un grupo de terceras personas recibirá la acción.",
        "1sg aor.pas": "Una sola persona habla de sí misma y recibió la acción (una vez).",
        "2sg aor.pas": "Le hablas a una persona que recibió la acción (una vez).",
        "3sg aor.pas": "Una tercera persona recibió la acción (una vez).",
        "1pl aor.pas": "Un grupo que incluye al hablante recibió la acción (una vez).",
        "2pl aor.pas": "Le hablas a un grupo que recibió la acción (una vez).",
        "3pl aor.pas": "Un grupo de terceras personas recibió la acción (una vez).",
    }
    return HINTS.get(person_label, person_label)

TENSE_SPANISH = {
    "Presente": 'En español: "yo desato", "yo estoy desatando".',
    "Imperfecto": 'En español: "yo desataba", "yo estaba desatando".',
    "Futuro Act/Med": 'En español: "yo desataré", "yo voy a desatar".',
    "Futuro Pas + Aoristo Pas": 'En español: "yo seré desatado" / "yo fui desatado".',
    "Aoristo Act/Med": 'En español: "yo desaté" (una vez, terminó).',
    "Perfecto": 'En español: "yo he desatado" (y sigue vigente).',
    "Pluscuamperfecto": 'En español: "yo había desatado" (antes de otra cosa).',
}

def build_front(verb_key, form_idx_in_tense, tense_idx):
    """Build the front of a card."""
    verb = VERBS[verb_key]
    offset = get_tense_offset(tense_idx)
    abs_idx = offset + form_idx_in_tense
    _, _, spanish = verb["forms"][abs_idx]
    tense_name, marker, endings = TENSES[tense_idx]
    _, person_label = endings[form_idx_in_tense]

    hint = _get_hint(person_label)

    # Use LLM-generated tense+voice Spanish, fallback to static
    cache_key = f"{verb_key}|{abs_idx}"
    cached = EXPLANATIONS.get(cache_key, {})
    tense_es = cached.get("tense_voice_spanish", TENSE_SPANISH.get(tense_name, ""))
    tense_es_line = f'En español: "{tense_es}"' if tense_es else ""

    # Show stem only (strip -ω/-ομαι from dictionary form)
    if verb_key.endswith("ομαι"):
        stem = verb_key[:-4]
    elif verb_key.endswith("ω"):
        stem = verb_key[:-1]
    else:
        stem = verb_key

    return nfc(
        f'<div style="font-size:24px;">{stem} + <span style="color:#d32f2f;font-weight:bold;">???</span></div>'
        f'{B}<div style="font-size:18px;"><em>"{spanish}"</em></div>'
        f'{B}<div style="font-size:14px;color:#666;">{hint}</div>'
        f'{B}<div style="font-size:14px;color:#666;">Tiempo: {tense_name} ({marker})</div>'
        f'{B}<div style="font-size:14px;color:#888;font-style:italic;">{tense_es_line}</div>'
    )

def build_back(verb_key, form_idx_in_tense, tense_idx):
    """Build the back with all 84 forms."""
    verb = VERBS[verb_key]
    offset = get_tense_offset(tense_idx)
    abs_idx = offset + form_idx_in_tense
    correct_form, correct_greek, correct_spanish = verb["forms"][abs_idx]

    tense_name, _, endings = TENSES[tense_idx]
    ending_text, person_label = endings[form_idx_in_tense]

    # Use LLM-generated explanation, fallback to old static one
    cache_key = f"{verb_key}|{abs_idx}"
    cached = EXPLANATIONS.get(cache_key, {})

    if "tense_explanation" in cached:
        # Determine voice label
        voice_parts = person_label.split()
        voice_code = voice_parts[1] if len(voice_parts) > 1 else "act"
        voice_label = {"act": "ACTIVA", "m/p": "MEDIA/PASIVA", "med": "MEDIA",
                       "fut.pas": "PASIVA", "aor.pas": "PASIVA"}.get(voice_code, voice_code.upper())
        # Determine pronoun
        pn = voice_parts[0]
        pronoun = {"1sg": "yo", "2sg": "tú", "3sg": "él/ella",
                   "1pl": "nosotros", "2pl": "ustedes", "3pl": "ellos"}.get(pn, "?")

        friendly = (
            f'<b>⏱ Tiempo: {tense_name.upper()}</b>{B}'
            f'{cached["tense_explanation"]}{B}{B}'
            f'<b>🎭 Voz: {voice_label}</b>{B}'
            f'{cached.get("voice_explanation", "")}{B}{B}'
            f'<b>👤 Persona: {pn.upper()} = "{pronoun}"</b>{B}'
            f'{cached.get("person_explanation", "")}{B}{B}'
            f'<b>🔗 Juntando todo:</b> {cached.get("summary", "")}'
        )
    elif cached.get("explanation"):
        friendly = cached["explanation"]
    else:
        friendly = _friendly_explanation(tense_name, person_label, correct_spanish)

    lines = [
        f'<div style="font-size:22px;"><b>{correct_form}</b> '
        f'<span style="color:#2e7d32;background:#e8f5e9;padding:2px 8px;border-radius:4px;">'
        f'✅ {ending_text}</span></div>',
        f'{B}<div style="font-size:18px;color:#1a237e;">{correct_greek}</div>'
        f'<div style="font-size:14px;color:#666;font-style:italic;">🔊 {byzantine_pronunciation(correct_greek)}</div>',
        f'{B}<div style="background:#f3f3f3;padding:14px;border-radius:8px;font-size:15px;line-height:1.8;">'
        f'{friendly}'
        f'</div>',
        f'{B}<hr>{B}',
    ]

    # All 84 forms grouped by tense
    global_idx = 0
    for t_name, t_marker, t_endings in TENSES:
        lines.append(f'<div style="color:#1565c0;font-weight:bold;margin-top:10px;font-size:14px;">'
                     f'▸ {t_name} — {t_marker}</div>')

        for i, (end_text, pers) in enumerate(t_endings):
            form, greek, spanish = verb["forms"][global_idx]
            if global_idx == abs_idx:
                lines.append(
                    f'<span style="color:#2e7d32;font-weight:bold;font-size:15px;">'
                    f'✅ <b>{form}</b> — {greek} — "{spanish}"</span>{B}'
                )
            else:
                # Brief reason
                reason = _get_reason(global_idx, abs_idx, t_name, tense_name, pers, person_label)
                lines.append(
                    f'<span style="color:#555;font-size:14px;">'
                    f'✗ <b>{form}</b> — {greek} — "{spanish}"</span>{B}'
                    f'<span style="color:#999;font-style:italic;font-size:12px;">→ {reason}</span>{B}'
                )
            global_idx += 1

    return nfc("".join(lines))

def _friendly_explanation(tense_name, person_label, spanish):
    """Build a deep, 14-year-old-friendly explanation of why this form is what it is."""
    B = "<br>"

    # Parse person label into components
    # e.g. "1sg act" → number=1, plural=False, voice="act"
    parts = person_label.split()
    person_num = parts[0]  # "1sg", "2pl", etc.
    voice_code = parts[1] if len(parts) > 1 else ""  # "act", "m/p", "med", "fut.pas", "aor.pas"

    # === TENSE explanation ===
    tense_explanations = {
        "Presente": (
            f'<b>⏱ Tiempo: PRESENTE</b>{B}'
            f'El <b>presente</b> describe algo que pasa <b>ahora mismo</b> o que se repite habitualmente.{B}'
            f'En español: "yo desato" (ahora), "yo desato todos los días" (hábito).{B}'
            f'En griego no tiene ninguna marca especial — es la forma "base" del verbo.'
        ),
        "Imperfecto": (
            f'<b>⏱ Tiempo: IMPERFECTO</b>{B}'
            f'El <b>imperfecto</b> describe algo que <b>pasaba continuamente</b> en el pasado. Como ver una película: la acción dura.{B}'
            f'En español: "yo desataba", "yo estaba desatando".{B}'
            f'Se reconoce por el <b>ἐ-</b> al inicio (llamado "augmento" = marca de pasado).'
        ),
        "Futuro Act/Med": (
            f'<b>⏱ Tiempo: FUTURO</b>{B}'
            f'El <b>futuro</b> describe algo que <b>pasará después</b>.{B}'
            f'En español: "yo desataré", "yo me desataré".{B}'
            f'Se reconoce por la <b>σ</b> insertada entre la raíz y la terminación. No tiene augmento (no es pasado).'
        ),
        "Futuro Pas + Aoristo Pas": (
            f'<b>⏱ Tiempo: FUTURO PASIVO o AORISTO PASIVO</b>{B}'
            f'Dos tiempos que comparten la marca <b>-θη-</b> (señal de voz pasiva).{B}'
            f'• <b>Futuro pasivo</b> = "seré desatado" (θη + σ + terminación){B}'
            f'• <b>Aoristo pasivo</b> = "fui desatado" (ἐ- + θη + terminación){B}'
            f'La diferencia: el aoristo tiene augmento ἐ- (pasado), el futuro no.'
        ),
        "Aoristo Act/Med": (
            f'<b>⏱ Tiempo: AORISTO</b>{B}'
            f'El <b>aoristo</b> describe algo que <b>pasó una vez</b> en el pasado. Como una foto: un momento puntual.{B}'
            f'En español: "yo desaté" (una vez, terminó).{B}'
            f'Se reconoce por <b>ἐ-</b> (augmento = pasado) + <b>σ</b> (marca de aoristo).{B}'
            f'Diferencia con imperfecto: imperfecto = "desataba" (duración), aoristo = "desaté" (puntual).'
        ),
        "Perfecto": (
            f'<b>⏱ Tiempo: PERFECTO</b>{B}'
            f'El <b>perfecto</b> describe algo que <b>se completó y su resultado sigue vigente ahora</b>.{B}'
            f'En español: "he desatado" (y sigue desatado).{B}'
            f'Se reconoce por la <b>reduplicación</b> (repetir la primera consonante + ε: λύω → <b>λε</b>λυκα) + <b>κ</b>.'
        ),
        "Pluscuamperfecto": (
            f'<b>⏱ Tiempo: PLUSCUAMPERFECTO</b>{B}'
            f'El <b>pluscuamperfecto</b> = algo que <b>se había completado antes de otro evento pasado</b>.{B}'
            f'En español: "había desatado" (antes de que pasara otra cosa).{B}'
            f'Se reconoce por <b>ἐ-</b> (augmento) + <b>reduplicación</b> + <b>κ</b>. Es el perfecto "en pasado".'
        ),
    }

    # === VOICE explanation ===
    voice_explanations = {
        "act": (
            f'<b>🎭 Voz: ACTIVA</b>{B}'
            f'<b>Activa</b> = el sujeto <b>hace</b> la acción. Él es el que actúa.{B}'
            f'Ejemplo: "Yo desato" → yo soy quien desata. La acción sale de mí.'
        ),
        "m/p": (
            f'<b>🎭 Voz: MEDIA/PASIVA</b>{B}'
            f'<b>Pasiva</b> = el sujeto <b>recibe</b> la acción. Alguien más se la hace.{B}'
            f'Ejemplo: "Yo soy desatado" → alguien me desata a mí.{B}'
            f'<b>Media</b> = el sujeto hace la acción <b>para sí mismo</b> o <b>sobre sí mismo</b>.{B}'
            f'Ejemplo: "Yo me desato" → yo mismo me libero.{B}'
            f'En griego, media y pasiva usan las <b>mismas terminaciones</b> (el contexto las distingue).'
        ),
        "med": (
            f'<b>🎭 Voz: MEDIA</b>{B}'
            f'<b>Media</b> = el sujeto hace la acción <b>para sí mismo</b> o en su propio interés.{B}'
            f'Ejemplo: "Yo me desataré la sandalia" → la acción me beneficia a mí.{B}'
            f'En futuro, la media tiene terminaciones propias (diferentes de la pasiva).'
        ),
        "fut.pas": (
            f'<b>🎭 Voz: PASIVA (futuro)</b>{B}'
            f'<b>Pasiva</b> = el sujeto <b>recibirá</b> la acción en el futuro.{B}'
            f'Ejemplo: "Yo seré liberado" → alguien me liberará.{B}'
            f'Se reconoce por <b>-θησ-</b> (θη de pasiva + σ de futuro).'
        ),
        "aor.pas": (
            f'<b>🎭 Voz: PASIVA (aoristo)</b>{B}'
            f'<b>Pasiva</b> = el sujeto <b>recibió</b> la acción una vez en el pasado.{B}'
            f'Ejemplo: "Yo fui liberado" → alguien me liberó (una vez, terminó).{B}'
            f'Se reconoce por <b>ἐ- + -θη-</b> (augmento de pasado + θη de pasiva).'
        ),
    }

    # === PERSON explanation ===
    person_map = {
        "1sg": ("yo", "una sola persona que habla de sí misma"),
        "2sg": ("tú", "le hablas directamente a una persona"),
        "3sg": ("él/ella", "hablas de una tercera persona que no está en la conversación"),
        "1pl": ("nosotros", "un grupo que incluye al que habla"),
        "2pl": ("ustedes", "le hablas a un grupo (sin incluirte a ti)"),
        "3pl": ("ellos", "un grupo de terceras personas"),
    }
    pronoun, person_desc = person_map.get(person_num, ("?", "?"))

    person_text = (
        f'<b>👤 Persona: {person_num.upper()} = "{pronoun}"</b>{B}'
        f'{person_desc}.{B}'
        f'<b>sg</b> = singular (uno solo). <b>pl</b> = plural (varios).{B}'
        f'<b>1ª</b> = quien habla. <b>2ª</b> = a quien le hablas. <b>3ª</b> = de quien hablas.'
    )

    # === Combine ===
    tense_text = tense_explanations.get(tense_name, f"Tiempo: {tense_name}")
    voice_text = voice_explanations.get(voice_code, f"Voz: {voice_code}")

    return (
        f'{tense_text}{B}{B}'
        f'{voice_text}{B}{B}'
        f'{person_text}{B}{B}'
        f'<b>🔗 Juntando todo:</b> {tense_name} + {voice_code} + {person_num} = "{spanish}"'
    )

def _get_reason(idx, correct_idx, this_tense, correct_tense, this_person, correct_person):
    """Generate a brief rejection reason."""
    parts = []
    if this_tense != correct_tense:
        parts.append(f"{this_tense}, no {correct_tense}")
    if this_person != correct_person:
        parts.append(f"{this_person}, no {correct_person}")
    if not parts:
        # Same tense and person label but different index (shouldn't happen with unique labels)
        parts.append("forma diferente")
    return " + ".join(parts)

def generate_deck(deck_idx, deck_name, model_id, deck_id, tense_idx):
    """Generate one deck with 50 cards."""
    model = genanki.Model(
        model_id,
        f'Terminaciones — {deck_name}',
        fields=[{'name': 'Front'}, {'name': 'Back'}],
        templates=[{
            'name': 'Card 1',
            'qfmt': '{{Front}}',
            'afmt': '{{FrontSide}}<hr id=answer>{{Back}}',
        }],
        css='.card { font-family: arial; font-size: 16px; text-align: left; color: black; background-color: white; padding: 20px; line-height: 1.6; }'
    )

    deck = genanki.Deck(deck_id, f'Koiné Griego::Terminaciones — {deck_name}')

    _, _, endings = TENSES[tense_idx]
    num_endings = len(endings)  # 12

    # Generate 50 cards: cycle through verbs and endings
    cards_generated = 0
    verb_idx = 0
    ending_idx = 0

    while cards_generated < 50:
        verb_key = VERB_KEYS[verb_idx % len(VERB_KEYS)]
        form_idx = ending_idx % num_endings

        front = build_front(verb_key, form_idx, tense_idx)
        back = build_back(verb_key, form_idx, tense_idx)
        deck.add_note(genanki.Note(model=model, fields=[front, back]))

        cards_generated += 1
        ending_idx += 1
        if ending_idx % num_endings == 0:
            verb_idx += 1

    out = os.path.join(os.path.dirname(__file__), f'deck_{deck_idx+1}_{deck_name.lower().replace(" ", "_").replace("+", "_")}.apkg')
    genanki.Package(deck).write_to_file(out)
    print(f"  ✅ {out} ({cards_generated} cards)")
    return out

def main():
    print(f"Verbs available: {len(VERB_KEYS)} ({', '.join(VERB_KEYS)})")
    print(f"Forms per verb: {len(VERBS[VERB_KEYS[0]]['forms'])}")
    print()

    for deck_idx, name, model_id, deck_id, tense_idx in DECK_CONFIGS:
        print(f"Generating Deck {deck_idx+1}: {name}...")
        generate_deck(deck_idx, name, model_id, deck_id, tense_idx)

    print(f"\n🎉 All 7 decks generated!")

