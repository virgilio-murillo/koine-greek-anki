#!/usr/bin/env python3
"""Generate Terminaciones Vol. 3 Anki deck as .apkg using genanki."""
import importlib, sys, os, genanki

sys.path.insert(0, os.path.dirname(__file__))

cards = []
for i in range(1, 8):
    mod = importlib.import_module(f"cards_vol3_cat{i}")
    cards.extend(mod.cards)

print(f"Collected {len(cards)} cards from 7 categories")

model = genanki.Model(
    1607392319,  # unique stable ID for this model
    'Terminaciones Vol.3',
    fields=[{'name': 'Front'}, {'name': 'Back'}],
    templates=[{
        'name': 'Card 1',
        'qfmt': '{{Front}}',
        'afmt': '{{FrontSide}}<hr id=answer>{{Back}}',
    }],
    css='.card { font-family: arial; font-size: 20px; text-align: left; color: black; background-color: white; padding: 20px; }'
)

deck = genanki.Deck(
    2098127543,  # unique stable ID different from any existing deck
    'Koiné Griego::Griego Koiné — Terminaciones Vol. 3'
)

for front, back in cards:
    deck.add_note(genanki.Note(model=model, fields=[front, back]))

out = os.path.join(os.path.dirname(__file__), 'terminaciones_vol3.apkg')
genanki.Package(deck).write_to_file(out)
print(f"Generated {out}")
print(f"Deck: {deck.name}")
print(f"Total cards: {len(cards)}")
