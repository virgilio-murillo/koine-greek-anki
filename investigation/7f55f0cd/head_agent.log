#!/usr/bin/env python3
"""Generate Greek Infinitives Anki deck."""
import importlib, sys, os
sys.path.insert(0, os.path.dirname(__file__))

cards = []
for i in range(1, 8):
    mod = importlib.import_module(f"cards_cat{i}")
    cards.extend(mod.cards)

with open(os.path.join(os.path.dirname(__file__), "greek_infinitives_anki.txt"), "w", encoding="utf-8") as f:
    for front, back in cards:
        f.write(f"{front}\t{back}\n")

print(f"Generated {len(cards)} cards to greek_infinitives_anki.txt")
