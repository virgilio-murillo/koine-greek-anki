import json, genanki, random, html

random.seed(42)
MODEL_ID = 1646410861305  # bumped for greek verses section
DECK_ID = 1646410861303  # new deck ID to avoid merge with old cached deck

with open("data/matthew/compounds_enriched.json") as f:
    cards = json.load(f)

# Model with Front/Back fields
model = genanki.Model(
    MODEL_ID,
    "Greek Compounds + Cognates",
    fields=[
        {"name": "Front"},
        {"name": "Back"},
    ],
